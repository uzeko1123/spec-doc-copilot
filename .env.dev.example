SDC_ENV=dev

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=sdc_user
POSTGRES_PASSWORD=sdc_password
POSTGRES_DB=sdc

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=sdc_user
REDIS_PASSWORD=sdc_password

AWS_S3_ENDPOINT_URL=http://localhost:8333
AWS_S3_CUSTOM_DOMAIN=localhost:8333/sdc
AWS_S3_URL_PROTOCOL=http:
AWS_ACCESS_KEY_ID=sdc_access_key_id
AWS_SECRET_ACCESS_KEY=sdc_secret_access_key
AWS_STORAGE_BUCKET_NAME=sdc

DJANGO_URL=http://localhost:8000
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=sdc_secret_key
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_SUPERUSER_USERNAME=sdc_user
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=sdc_password
DJANGO_ALTCHA_HMAC_SECRET=sdc_altcha_hmac_secret
DJANGO_ALTCHA_HMAC_KEY_SECRET=sdc_altcha_hmac_key_secret
