SDC_ENV=prod

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sdc_user
POSTGRES_PASSWORD=sdc_password
POSTGRES_DB=sdc

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=sdc_user
REDIS_PASSWORD=sdc_password

AWS_S3_ENDPOINT_URL=http://seaweedfs:8333
AWS_S3_CUSTOM_DOMAIN=localhost/storage
AWS_S3_URL_PROTOCOL=https:
AWS_ACCESS_KEY_ID=sdc_access_key_id
AWS_SECRET_ACCESS_KEY=sdc_secret_access_key
AWS_STORAGE_BUCKET_NAME=sdc

DJANGO_URL=http://django:8000
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=sdc_secret_key
DJANGO_ALLOWED_HOSTS=localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DJANGO_CORS_ALLOWED_ORIGINS=https://localhost
DJANGO_SUPERUSER_USERNAME=sdc_user
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=sdc_password
DJANGO_ALTCHA_HMAC_SECRET=sdc_altcha_hmac_secret
DJANGO_ALTCHA_HMAC_KEY_SECRET=sdc_altcha_hmac_key_secret
DJANGO_FRONTEND_URL=https://localhost

DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_USE_TLS=0
DJANGO_EMAIL_USE_SSL=0
DJANGO_EMAIL_HOST_USER=spec-doc-copilot@example.com
DJANGO_EMAIL_HOST_PASSWORD=sdc_password
DJANGO_DEFAULT_FROM_EMAIL=spec-doc-copilot@example.com

VITE_BACKEND_URL=http://localhost

NGINX_SERVER_NAME=localhost

BACKUP_CRON_SCHEDULE="0 0 * * *"
BACKUP_KEEP_DAYS=7
